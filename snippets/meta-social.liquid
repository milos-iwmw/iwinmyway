{%- comment -%} Open Graph + Twitter Card tags {%- endcomment -%}
{%- assign og_title = page_title | default: shop.name -%}
{%- assign og_description = page_description | default: shop.description | default: shop.name -%}
{%- assign og_image = settings.share_image | default: settings.logo_full_white -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if og_image != blank -%}
<meta property="og:image" content="{{ og_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="1200">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image != blank -%}
<meta name="twitter:image" content="{{ og_image | image_url: width: 1200 }}">
{%- endif -%}
{%- if settings.social_instagram != blank -%}
<meta name="twitter:site" content="{{ settings.social_instagram }}">
{%- endif -%}
