<section class="wrap" style="padding-bottom:clamp(70px,10vh,130px)">
  {% render 'section-head', number: section.settings.number, title: section.settings.title, label: section.settings.label %}
  <div class="diag">
    {%- for block in section.blocks -%}
      <div class="dcell rv" {{ block.shopify_attributes }}>
        <div class="dn">{{ block.settings.tag }}</div>
        <h4>{{ block.settings.title }}</h4>
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Build phases",
  "settings": [
    { "type": "text", "id": "number", "label": "Section number", "default": "03" },
    { "type": "text", "id": "title", "label": "Section title", "default": "The Build Phases" },
    { "type": "text", "id": "label", "label": "Section tag label", "default": "How a block runs" }
  ],
  "blocks": [
    {
      "type": "phase",
      "name": "Phase",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "PHASE 01" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "phase", "settings": { "tag": "PHASE 01", "title": "Assess", "text": "Full physical and performance testing. Force, range, asymmetry, history. We establish the baseline and define the target — the number we're engineering toward." } },
      { "type": "phase", "settings": { "tag": "PHASE 02", "title": "Engineer", "text": "Programming built backwards from the target. Strength, force development, mobility and recovery sequenced deliberately — nothing random, everything progressive." } },
      { "type": "phase", "settings": { "tag": "PHASE 03", "title": "Verify", "text": "Re-test against the baseline. Measured change, not vibes. The result either shows in the numbers or the block gets adjusted — the loop repeats." } }
    ]
  },
  "presets": [{ "name": "Build phases" }]
}
{% endschema %}
