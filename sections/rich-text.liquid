<section class="wrap{% if section.settings.padded %} pad{% endif %}">
  {% render 'section-head', number: section.settings.number, title: section.settings.title, label: section.settings.label %}
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:60px;padding-block:56px;align-items:start" class="mgrid-2">
    <div class="h2big rv">{{ section.settings.heading }}</div>
    <div class="rv" style="max-width:52ch;display:flex;flex-direction:column;gap:18px">
      {%- if section.settings.lead != blank -%}<p class="muted" style="font-size:clamp(16px,1.6vw,20px);line-height:1.6">{{ section.settings.lead }}</p>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="muted" style="font-size:15px;line-height:1.65">{{ section.settings.text }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text intro",
  "settings": [
    { "type": "checkbox", "id": "padded", "label": "Extra top/bottom padding", "default": true },
    { "type": "text", "id": "number", "label": "Section number", "default": "01" },
    { "type": "text", "id": "title", "label": "Section title" },
    { "type": "text", "id": "label", "label": "Section tag label" },
    { "type": "text", "id": "heading", "label": "Big heading (supports <br>)" },
    { "type": "textarea", "id": "lead", "label": "Lead paragraph" },
    { "type": "textarea", "id": "text", "label": "Body paragraph" }
  ],
  "presets": [{ "name": "Rich text intro" }]
}
{% endschema %}
