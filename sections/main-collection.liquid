<div class="phead" style="padding-bottom:clamp(50px,7vh,80px)">
  <div class="bg"></div><div class="gl"></div>
  <div class="inner">
    <div class="crumb"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span class="lbl">/</span><a href="{{ collection.url }}">{{ collection.title }}</a></div>
    <h1 style="font-size:clamp(34px,6vw,72px)">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="sub">{{ collection.description }}</div>{%- endif -%}
  </div>
</div>

{% paginate collection.products by 24 %}
<section class="wrap pad">
  <div class="incl">
    {%- for product in collection.products -%}
      <a href="{{ product.url }}" class="icell rv" style="text-decoration:none">
        <div class="in">{{ forloop.index0 | plus: 1 }}</div>
        <h4>{{ product.title }}</h4>
        <p>{{ product.price | money }}</p>
      </a>
    {%- else -%}
      <div class="icell"><p>{{ 'general.no_products' | t }}</p></div>
    {%- endfor -%}
  </div>

  {%- if paginate.pages > 1 -%}
    <div style="margin-top:40px;display:flex;gap:10px">
      {%- if paginate.previous -%}{% render 'button', label: '←', url: paginate.previous.url, arrow: false %}{%- endif -%}
      {%- if paginate.next -%}{% render 'button', label: '→', url: paginate.next.url, arrow: false %}{%- endif -%}
    </div>
  {%- endif -%}
</section>
{% endpaginate %}
