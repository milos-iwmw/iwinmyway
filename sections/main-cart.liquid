<div class="phead" style="padding-bottom:clamp(50px,7vh,80px)">
  <div class="bg"></div><div class="gl"></div>
  <div class="inner">
    <div class="crumb"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span class="lbl">/</span><a href="{{ routes.cart_url }}">{{ 'cart.title' | t }}</a></div>
    <h1 style="font-size:clamp(34px,6vw,72px)">{{ 'cart.title' | t }}</h1>
  </div>
</div>

<section class="wrap pad">
  {%- if cart.item_count == 0 -%}
    <p class="muted" style="font-size:18px">{{ 'cart.empty' | t }}</p>
    <div style="margin-top:30px">{% render 'button', label: 'cart.continue' | t, url: routes.root_url, style: 'solid', size: 'lg' %}</div>
  {%- else -%}
    {%- form 'cart', cart -%}
      <div style="display:flex;flex-direction:column;gap:1px;background:var(--line);border:1px solid var(--line);margin-bottom:34px">
        {%- for item in cart.items -%}
          <div style="background:var(--bg);padding:22px 26px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap">
            <div>
              <div style="font-size:16px;font-weight:500;text-transform:uppercase">{{ item.product.title }}</div>
              {%- unless item.variant.title == 'Default Title' -%}
                <div class="mono" style="font-size:12px;color:var(--ink-3);margin-top:4px">{{ item.variant.title }}</div>
              {%- endunless -%}
            </div>
            <div style="display:flex;align-items:center;gap:18px">
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:70px;background:var(--bg-2);border:1px solid var(--line);color:var(--ink);padding:8px 10px;font-family:var(--mono)">
              <div class="mono" style="font-size:15px">{{ item.final_line_price | money }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap">
        <div class="mono" style="font-size:20px">{{ 'cart.subtotal' | t }}: {{ cart.total_price | money }}</div>
        <div style="display:flex;gap:14px;flex-wrap:wrap">
          <button type="submit" name="update" class="btn">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="btn solid lg">{{ 'cart.checkout' | t }} <span class="ar">→</span></button>
        </div>
      </div>
    {%- endform -%}
  {%- endif -%}
</section>
